// --- Tenancy (PRD §7) ---

/// What kind of school this is (plan §0.5 → Phase 1.0, decision 1). It decides which kind of academic period a school has
/// (term / semester / cohort). Additive, with a default, so every existing school migrates as K12.
enum SchoolType {
  K12
  HIGHER_ED
  VOCATIONAL
}

model Tenant {
  id         String     @id @default(cuid())
  /// URL slug (PRD §7 "Tenant code selection") — unique, reserved-word-checked
  /// and format-validated at the application layer before insert, fixed at
  /// creation for MVP (support-mediated changes only).
  code       String     @unique
  name       String
  /// Defaults to K12 because every school that exists today is one; the setup wizard does not ask until the Settings screen exists.
  schoolType SchoolType @default(K12)
  createdAt  DateTime   @default(now())

  campuses          Campus[]
  memberships       TenantMembership[]
  invitations       Invitation[]
  /// Exactly one row, created by the database when the tenant is (a trigger — see the phase 1.0 migration).
  settings          SchoolSettings?
  sessions          AcademicSession[]
  periods           AcademicPeriod[]
  classGroups       ClassGroup[]
  classArms         ClassArm[]
  subjects          Subject[]
  offerings         SubjectOffering[]
  schemes           AssessmentScheme[]
  components        AssessmentComponent[]
  gradeScales       GradeScale[]
  gradeBands        GradeBand[]
  staffRecords      StaffRecord[]
  staffAssignments  StaffSubjectAssignment[]
  studentRecords    StudentRecord[]
  admissionCounters AdmissionCounter[]
  guardianRecords   GuardianRecord[]
  guardianLinks     GuardianLink[]
  enrollments       StudentEnrollment[]
}

/// A branch/campus under one tenant (PRD §7) — distinct from multi-tenancy:
/// same school, same fee structure/oversight, narrower scope inside one
/// tenant rather than a second tenant.
model Campus {
  id       String @id @default(cuid())
  tenantId String
  name     String

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships    TenantMembership[]
  invitations    Invitation[]
  sessions       AcademicSession[]
  classGroups    ClassGroup[]
  staffRecords   StaffRecord[]
  studentRecords StudentRecord[]

  /// A school cannot have two campuses of the same name (compared exactly, after the API trims it).
  @@unique([tenantId, name])
  /// The target of the composite foreign keys that keep academic rows inside their own school (plan, Phase 1.1 reconciliation 2).
  @@unique([tenantId, id])
  @@index([tenantId])
}

enum Role {
  ADMIN
  TEACHING_STAFF
  NON_TEACHING_STAFF
  STUDENT
  PARENT
}

/// The deliberately small permission set (plan §1.7): an ADMIN implicitly has all of them; the enum exists so a NON-admin staff
/// membership can be granted one extra capability. No custom roles, no per-record ACLs, no hierarchy.
enum Permission {
  CAN_APPROVE_RESULTS
  CAN_MANAGE_FINANCE
  CAN_PUBLISH_CONTENT
  CAN_MANAGE_USERS
}

/// The verified membership table PRD §7's tenant-trust-boundary check reads:
/// "authenticated user -> verified tenant membership -> SET LOCAL
/// app.tenant_id -> RLS". The URL's tenant code is only ever a hint; this
/// table is the actual authorization source.
model TenantMembership {
  id          String       @id @default(cuid())
  userId      String
  tenantId    String
  campusId    String?
  role        Role
  /// Extra capabilities beyond the role. Only staff roles may hold any (a CHECK constraint in the phase 1.0 migration states it:
  /// `permissions = '{}' OR role IN ('TEACHING_STAFF','NON_TEACHING_STAFF')`); ADMIN implies every permission and holds none stored.
  permissions Permission[] @default([])

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus          Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  /// The records (at most one each, enforced by partial unique indexes) that name this membership's person as their sign-in account.
  staffRecords    StaffRecord[]
  studentRecords  StudentRecord[]
  guardianRecords GuardianRecord[]

  /// Set when an administrator deactivates the person IN THIS SCHOOL. The row stays (history, reactivation) but it is no
  /// longer a membership: every reader treats a deactivated one as absent — the resolver, the person's school list, the
  /// sign-in admin check, the audit fan-out.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// An invitation to join a school (plan §0.5.4). The link carries a 256-bit random token in the URL FRAGMENT; only its
/// SHA-256 hash is stored here — a leaked database yields no usable link. Single-use (acceptedAt), revocable (revokedAt),
/// expiring (expiresAt). Tenant-scoped like every table with a tenantId: row-level security in the same migration, plus ONE
/// extra read path — by the token's hash — because the invitee is not a member of anything yet when they open the link.
model Invitation {
  id            String  @id @default(cuid())
  tenantId      String
  /// Lower-cased. The invitation is for whoever controls this address; opening the link is the proof.
  email         String
  role          Role
  campusId      String?
  /// When set, accepting this invitation also links the new member to that staff record (plan 1.2, decision P5).
  staffRecordId String?

  tokenHash String @unique

  invitedById  String?
  acceptedById String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus      Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  staffRecord StaffRecord? @relation(fields: [tenantId, staffRecordId], references: [tenantId, id], onDelete: NoAction)
  invitedBy   User?        @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy  User?        @relation("InvitationsAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([tenantId, createdAt])
}
