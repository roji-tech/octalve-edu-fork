# Copy to .env and fill in. Never commit .env.

# --- Deployment mode (PRD §7) ---
# "saas"  = multi-tenant, self-serve signup, /schools/[code]/... routing active
# "solo"  = single-tenant self-hosted install, tenant resolution disabled
DEPLOYMENT_MODE=saas

# --- Database (PRD §7: Postgres + Prisma + RLS via forTenant()) ---
# TWO roles (domain-implementation-plan.md §0.5.2). The app connects as `app_user` — it is subject to row-level security,
# which is what keeps one school's rows from another's. `DIRECT_URL` is the role that owns the tables and runs migrations
# (`pnpm exec prisma migrate deploy`); it must never be the runtime URL, or RLS silently does nothing.
# Create `app_user` once: the docker compose database does it for you (docker/postgres/init), or run `pnpm db:roles`.
DATABASE_URL="postgresql://app_user:app_user@localhost:5433/octalve_edu"
DIRECT_URL="postgresql://octalve:octalve@localhost:5433/octalve_edu"
# Production only: set to "true" to start with a runtime role that bypasses RLS (a single-user dev box). Normally unset —
# the app refuses to serve tenant data on a role that is a superuser, has BYPASSRLS, or owns the tables.
ALLOW_RLS_BYPASS=

# --- Tests (optional) ---
# `pnpm test` runs against "<database>_test" derived from DIRECT_URL (the ADMIN role: it arranges fixtures across schools,
# so it must be a superuser or have BYPASSRLS — the docker role is a superuser) while the servers under test connect as
# `app_user`. Both are created/migrated automatically. Set these to point elsewhere — the database name MUST end in "_test";
# every destructive test helper refuses to touch any other database.
# TEST_DATABASE_URL="postgresql://octalve:octalve@localhost:5433/octalve_edu_test"
# TEST_APP_DATABASE_URL="postgresql://app_user:app_user@localhost:5433/octalve_edu_test"

# --- Redis (BullMQ jobs, rate limiting — PRD §7 stack table) ---
REDIS_URL="redis://localhost:6380"

# --- Auth: hand-rolled database sessions (PRD §7; Auth.js is not used) ---
# The public URL users reach the app at. Its SCHEME decides the session
# cookie's shape: https:// -> "__Host-octalve.session-token" with the Secure
# flag; http:// -> plain "octalve.session-token", not Secure. Derived from this
# value, not NODE_ENV, so a LAN install genuinely served over http:// in
# production mode still gets a working cookie (browsers silently drop a Secure
# cookie over http). Must be https:// for any internet-facing deployment.
APP_URL=http://localhost:3000

# Which header carries the real client IP for rate limiting. Must be a header
# YOUR reverse proxy sets/overwrites — never one the client can supply.
#   x-real-ip       (default) e.g. nginx: proxy_set_header X-Real-IP $remote_addr;
#                   Caddy: header_up X-Real-IP {remote_host}
#   x-forwarded-for reads the Nth entry from the RIGHT (N = TRUSTED_PROXY_HOPS);
#                   entries to the left are client-controlled and never read.
# Unset/absent header (plain local dev) = one shared "unproxied" bucket.
CLIENT_IP_HEADER=x-real-ip
TRUSTED_PROXY_HOPS=1

# CSRF compares a request's Origin with its own host. That is the `Host` header — unless a reverse proxy in front of
# the app sets X-Forwarded-Host (and OVERWRITES any client-supplied one), in which case set this to true. Never set it
# true when the app is reachable directly: any client could then pick the host their own Origin is compared with.
TRUST_FORWARDED_HOST=

# --- First-run setup wizard (Solo only, PRD §4) ---
# Optional defense-in-depth: if set, /setup requires this value too.
SETUP_TOKEN=

# --- Payments (PRD §5/§9) ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# --- Email (PRD §7 stack table) ---
RESEND_API_KEY=

# --- SMS/WhatsApp (PRD §5, §9 NCC compliance) ---
TERMII_API_KEY=

# --- Outgoing email (password reset / change notices) ---
# resend | console | file. Unset: resend if RESEND_API_KEY is set, else console (prints links to the log —
# fine for development, delivers to no one in production).
EMAIL_TRANSPORT=
# The sender, e.g. "Your School <no-reply@yourschool.com>" (a domain verified with Resend).
EMAIL_FROM=

# --- Two-step verification (TOTP) ---
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts every authenticator secret at rest and keys the
# recovery-code hashes. REQUIRED for two-step verification to be available at all (without it the account page
# says so and enrolment answers 503 — there is deliberately no default). Keep it out of the database and backups
# of it; losing it means everyone must set two-step verification up again (`pnpm mfa:reset -- <email>`).
MFA_ENCRYPTION_KEY=

# --- Development tools (the in-app dev email inbox; a mock payment checkout later) ---
# What kind of deployment this is: development | staging | production. Unset: production under `next start`
# (NODE_ENV=production), development under `next dev`. ANY other value is treated as production — fail closed.
APP_ENV=
# Local development: the tools are on by default (set false to hide them). Staging: set true AND DEV_TOOLS_TOKEN.
# Production: never available, whatever these say.
DEV_TOOLS=
# Staging only — a shared secret typed once into the dev inbox widget. Without it the tools stay off on staging
# (the inbox holds password-reset links and security notices, so it must not be readable by anyone who finds the URL).
DEV_TOOLS_TOKEN=
